# ==============================================================================
# Gas Turbine Maintenance Assistant - Configuration
# ==============================================================================

# LLM Provider: 'local' (default, no API key needed), 'ollama', 'openai', 'gemini', 'anthropic'
LLM_PROVIDER=local

# Model selection for API providers (ignored when using local)
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gemini-1.5-flash

# Optional API Keys (Only needed if switching from 'local' to external providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama Host (if using 'ollama' provider)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Vector Store and Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
MAX_RETRIEVAL_DISTANCE=0.55
CHUNK_SIZE=900
CHUNK_OVERLAP=120
